<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content">
<com.google.android.material.card.MaterialCardView android:id="@+id/luma_profile_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/luma_surface" app:cardElevation="0dp" app:cardCornerRadius="22dp" app:strokeColor="@color/luma_outline" app:strokeWidth="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/luma_profile_flag" android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp" android:background="@drawable/luma_icon_background" android:scaleType="fitCenter" android:src="@drawable/ic_luma_globe" android:contentDescription="@string/luma_profile_region_unknown"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Luma.Title" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textAppearance="@style/Luma.Body" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/luma_profile_action" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="4dp" android:contentDescription="@string/luma_use"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/profile_menu" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_luma_more" android:contentDescription="@string/luma_more"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ICCID" android:textColor="@color/luma_muted" android:textSize="11sp" android:letterSpacing="0.05"/>
        <TextView android:id="@+id/iccid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginStart="10dp" android:fontFamily="monospace" android:ellipsize="end" android:maxLines="1" android:textColor="@color/luma_muted" android:textSize="12sp" android:background="?attr/selectableItemBackground" android:contentDescription="@string/luma_privacy"/>
<TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/luma_status_background" android:textSize="12sp" android:textColor="@color/luma_primary"/>
        <TextView android:id="@+id/profile_sequence_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/luma_muted"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/profile_class_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_class" android:textAppearance="@style/Luma.Body" android:visibility="gone"/>
        <TextView android:id="@+id/profile_class" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textAppearance="@style/Luma.Body" android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</FrameLayout>
