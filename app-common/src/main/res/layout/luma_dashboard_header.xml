<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="8dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/luma_hero" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/luma_device_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/luma_on_container" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/luma_device_ready" android:textAppearance="@style/Luma.Body"/>
                </LinearLayout>
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="9dp" android:background="@drawable/luma_icon_background" android:src="@drawable/ic_luma_sim" android:importantForAccessibility="no"/>
            </LinearLayout>
            <TextView android:id="@+id/luma_eid" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/luma_muted" android:background="?attr/selectableItemBackground" android:contentDescription="@string/luma_eid_hint"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp" android:background="@color/luma_outline"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/luma_total_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/Luma.Title"/>
                <TextView android:id="@+id/luma_enabled_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/luma_primary" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/luma_card_info" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="@string/luma_card_info" android:textSize="12sp" android:paddingHorizontal="4dp" app:icon="@drawable/ic_luma_info" app:iconSize="18dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/luma_notifications" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="@string/luma_notifications" android:textSize="12sp" android:paddingHorizontal="4dp" app:icon="@drawable/ic_luma_notifications" app:iconSize="18dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/luma_download" style="@style/Luma.Button" android:layout_width="0dp" android:layout_weight="1.15" android:layout_height="52dp" android:text="@string/luma_add" android:textSize="12sp" android:paddingHorizontal="8dp" app:icon="@drawable/ic_add" app:iconSize="18dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/luma_profiles" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/luma_text" android:fontFamily="sans-serif-medium"/>
    <com.google.android.material.chip.ChipGroup android:id="@+id/luma_filters" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp">
        <com.google.android.material.chip.Chip android:id="@+id/luma_filter_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/luma_all"/>
        <com.google.android.material.chip.Chip android:id="@+id/luma_filter_active" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/luma_active"/>
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
